    <suppress>
        <notes><![CDATA[
        Suppress all vulnerabilities for all FasterXML Jackson 2.21.x artifacts.
        The scan incorrectly matches jackson-core, jackson-databind and jackson-modules-java8 CPEs.
        This application does not use polymorphic deserialization (activateDefaultTyping),
        so the primary attack vectors for these CVEs do not apply.
        Upgrade path to 2.21.4+ is tracked separately.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson\.core/jackson-.*@2\.21\..*$</packageUrl>
        <cve>CVE-2026-54512</cve>
    </suppress>
    <suppress>
        <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson\.core/jackson-.*@2\.21\..*$</packageUrl>
        <cve>CVE-2026-54513</cve>
    </suppress>
    <suppress>
