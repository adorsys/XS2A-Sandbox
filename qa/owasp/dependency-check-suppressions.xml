    <!-- httpcore 4.x: CPE matches httpcore5 CVEs (different project/namespace) -->
    <suppress>
        <notes><![CDATA[
        False positive: httpcore 4.x is matched against CVEs targeting Apache HttpComponents Core 5.x.
        These are separate libraries with separate CPE namespaces.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.httpcomponents/httpcore@4\..*$</packageUrl>
        <cpe>cpe:/a:apache:httpcomponents_core</cpe>
    </suppress>
    <suppress>
        <packageUrl regex="true">^pkg:maven/org\.apache\.httpcomponents/httpcore@4\..*$</packageUrl>
        <cve>CVE-2026-54399</cve>
    </suppress>
    <suppress>
        <packageUrl regex="true">^pkg:maven/org\.apache\.httpcomponents/httpcore@4\..*$</packageUrl>
        <cve>CVE-2026-54428</cve>
    </suppress>

    <!-- kotlin-stdlib / -common / -jdk7 / -jdk8: build-daemon cache deserialization and deprecated temp file APIs -->
    <suppress>
        <notes><![CDATA[
        CVE-2026-53914 affects Kotlin build daemon cache deserialization, not the deployed application binary.
        CVE-2020-29582 relates to deprecated createTempFile/createTempDir APIs not used in this project.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/kotlin-stdlib(-common|-jdk7|-jdk8)?@.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!-- log4j-api: vulnerabilities reside in log4j-core, which is NOT on the classpath -->
    <suppress>
        <notes><![CDATA[
        log4j-api is the logging API surface only. Critical vulnerabilities (Log4Shell etc.)
        require log4j-core, which is NOT present on this project's classpath.
        New CVEs CVE-2026-34479, CVE-2026-34477, CVE-2026-49844 also target log4j-core internals.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-api@.*$</packageUrl>
        <cpe>cpe:/a:apache:log4j</cpe>
    </suppress>
    <suppress>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-api@.*$</packageUrl>
        <cve>CVE-2026-34479</cve>
    </suppress>
    <suppress>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-api@.*$</packageUrl>
        <cve>CVE-2026-34477</cve>
    </suppress>
    <suppress>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-api@.*$</packageUrl>
        <cve>CVE-2026-49844</cve>
    </suppress>

