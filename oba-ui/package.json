{
  "name": "oba-ui",
  "version": "4.3.0",
  "scripts": {
    "start": "ng serve --port=4400 --proxy-config=proxy.conf.json",
    "load-api": "bash load-api.sh",
    "swagger-gen": "npm run load-api && ng-swagger-gen -i ./src/app/api/swagger/oba.json -o ./src/app/api",
    "remove-and-swagger-gen": "rm -rf ./src/app/api && npm run swagger-gen",
    "build": "ng build",
    "build:prod": "ng build --prod",
    "test-with-swagger": "rm -rf ./src/app/api && npm run swagger-gen && ng test",
    "test": "ng test",
    "test-ci": "ng test --browsers ChromeCi --watch=false --code-coverage",
    "lint": "npx eslint src/app/. ",
    "lint:fix": "npx eslint src/app/. --fix",
    "e2e": "ng e2e",
    "prettier": "find . -name '*.js' -or -name '*.ts' -or -name '*.html' -or -name '*.css' -or -name '*.scss'| grep -v build | grep -v \"assets/lib\" | grep -v node_modules | grep -v dist | xargs prettier --write"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.13",
    "@angular/cdk": "^18.2.14",
    "@angular/common": "^18.2.13",
    "@angular/compiler": "^18.2.13",
    "@angular/core": "^18.2.13",
    "@angular/forms": "^18.2.13",
    "@angular/material": "^18.2.14",
    "@angular/platform-browser": "^18.2.13",
    "@angular/platform-browser-dynamic": "^18.2.13",
    "@angular/router": "^18.2.13",
    "@auth0/angular-jwt": "^5.0.2",
    "@ng-bootstrap/ng-bootstrap": "^17.0.0",
    "@popperjs/core": "^2.11.7",
    "bootstrap": "^5.3.0",
    "browser-detect": "^0.2.28",
    "css-vars-ponyfill": "^2.4.3",
    "date-fns": "^2.30.0",
    "http-status-codes": "^2.1.4",
    "material-icons": "^1.13.5",
    "ng-http-loader": "15.0.0",
    "ng-multiselect-dropdown": "^1.0.0",
    "ngx-clipboard": "^16.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.20",
    "@angular/cli": "^18.2.20",
    "@angular/compiler-cli": "^18.2.13",
    "@angular/language-service": "^18.2.13",
    "@angular/localize": "^18.2.13",
    "@types/jasmine": "^4.3.1",
    "@types/jasminewd2": "^2.0.8",
    "@types/node": "^18.19.23",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.0",
    "eslint-plugin-angular": "^4.1.0",
    "eslint-plugin-autofix": "^1.1.0",
    "husky": "^9.0.11",
    "jasmine-core": "~4.6.0",
    "jasmine-spec-reporter": "~7.0.0",
    "jquery": "^3.5.1",
    "karma": "^6.3.19",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-swagger-gen": "^2.3.0",
    "prettier": "^2.2.1",
    "puppeteer": "^23.5.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "form-data": "^4.0.0",
    "tmp": "^0.2.1"
  }
}
