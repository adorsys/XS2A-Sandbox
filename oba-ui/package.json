{
  "name": "oba-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "load-api": "bash load-api.sh",
    "swagger-gen": "npm run load-api && ng-swagger-gen -i ./src/app/api/swagger/oba.json -o ./src/app/api",
    "remove-and-swagger-gen": "rm -rf ./src/app/api && npm run swagger-gen",
    "start": "ng serve --port=4400 --proxy-config=proxy.conf.json",
    "build": "ng build",
    "build:prod": "ng build --prod",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test-ci": "ng test --browsers ChromeCi --watch=false --code-coverage",
    "lint": "npx eslint src/app/. ",
    "lint:fix": "npx eslint src/app/. --fix"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.26",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.26",
    "@angular/compiler": "^20.3.26",
    "@angular/core": "^20.3.26",
    "@angular/forms": "^20.3.26",
    "@angular/localize": "^20.3.26",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.26",
    "@angular/platform-browser-dynamic": "^20.3.26",
    "@angular/router": "^20.3.26",
    "@auth0/angular-jwt": "^5.0.2",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.0",
    "browser-detect": "^0.2.28",
    "css-vars-ponyfill": "^2.4.3",
    "date-fns": "^2.30.0",
    "material-icons": "^1.13.5",
    "ng-http-loader": "^15.0.0",
    "ng-multiselect-dropdown": "^1.0.0",
    "ngx-clipboard": "^16.0.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.32",
    "@angular/cli": "^20.3.32",
    "@angular/compiler-cli": "^20.3.26",
    "@angular/language-service": "^20.3.26",
    "@types/jasmine": "~5.1.0",
    "@types/jasminewd2": "^2.0.8",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.0",
    "eslint-plugin-angular": "^4.1.0",
    "eslint-plugin-autofix": "^1.1.0",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "form-data": "^4.0.0",
    "tmp": "^0.2.1"
  }
}
